# Copy to .env and fill in. wfguard loads .env from the working directory at
# startup. .env is gitignored; .env.example is checked in as a template.
#
# You only need the keys for the path you actually use:
#   - Hosted Gemma 4 via the Gemini API  -> GEMINI_API_KEY
#   - A local / self-hosted OpenAI-compatible server -> the WFGUARD_BACKEND +
#     WFGUARD_OPENAI_BASE_URL (+ OPENAI_API_KEY if the server requires it) block
# GITHUB_TOKEN is used by the resolver in both cases.

# --- GitHub (resolver) ------------------------------------------------------
# GitHub personal access token, scope: public_repo (or repo for private repos).
# Without it, anonymous GitHub API rate limits apply (~60 req/hr).
GITHUB_TOKEN=

# --- Backend selection ------------------------------------------------------
# gemini (default) talks to the Gemini API; openai talks to any
# OpenAI-compatible server (Unsloth, vLLM, llama.cpp, Ollama, LM Studio, or a
# hosted gateway). Setting this lets you omit --backend on the command line.
WFGUARD_BACKEND=gemini

# Model id. For gemini, a Gemma 4 model id; for openai, whatever your server
# exposes at GET <base-url>/models.
#   gemini examples:  gemma-4-31b-it (dense, primary), gemma-4-e4b-it (small),
#                     gemma-4-26b-a4b-it (MoE)
WFGUARD_MODEL=gemma-4-31b-it

# --- Gemini API backend -----------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey
# Required only when WFGUARD_BACKEND=gemini (or --backend gemini).
GEMINI_API_KEY=

# --- OpenAI-compatible backend ----------------------------------------------
# Base URL of your OpenAI-compatible server, including the /v1 suffix.
# Examples:
#   http://localhost:1234/v1     (LM Studio default)
#   http://192.168.1.2:8888/v1   (a self-hosted Unsloth server on the LAN)
#   http://localhost:8000/v1     (vLLM / llama.cpp llama-server default)
#   http://localhost:11434/v1    (Ollama)
WFGUARD_OPENAI_BASE_URL=http://localhost:1234/v1

# API key for the OpenAI-compatible endpoint. Leave blank for servers that
# don't require auth (e.g. a default LM Studio). Set it for servers/gateways
# that do — e.g. an Unsloth server started with an API key, or a hosted
# OpenAI-compatible provider.
OPENAI_API_KEY=

# --- Misc -------------------------------------------------------------------
# Log level: debug | info | warn | error. Default: warn (the human-readable
# scan report is the interactive UX, not log lines). Uncomment to surface
# routine plumbing logs — useful when debugging --llm runs or harden retries.
# WFGUARD_LOG_LEVEL=info

# Comma-separated GitHub orgs to treat as trusted publishers. Augments the
# built-in well-known list (actions, github, docker, aws-actions, azure,
# google-github-actions, hashicorp, cloudflare, microsoft). For first-party
# actions in your own org, list your org here to silence unpinned-action and
# secrets-exposure findings on tag-pinned references. Compromised actions
# (e.g. tj-actions) keep firing regardless. Same as --trusted-org.
# WFGUARD_TRUSTED_ORGS=my-org,another-trusted-vendor
