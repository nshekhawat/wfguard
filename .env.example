# Copy to .env and fill in.
# .env is gitignored; .env.example is checked in as a template.

# Required: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required: GitHub personal access token, scope: public_repo (or repo for private targets)
GITHUB_TOKEN=

# Optional: override the Gemma 4 model id. Default: gemma-4-31b-it.
# Other Gemma 4 variants worth trying:
#   gemma-4-e4b-it       (small, fast)
#   gemma-4-26b-a4b-it   (MoE, ~4B active params)
#   gemma-4-31b-it       (dense, primary)
WFGUARD_MODEL=gemma-4-31b-it

# Optional: log level. One of: debug, info, warn, error. Default: info.
WFGUARD_LOG_LEVEL=info
